# Copy this file to terraform.tfvars and update with your values

aws_region         = "ap-northeast-1"
project_name       = "daily-cost-monitor"
days_to_check      = 7

# Environment and system tags
environment = "dev"
system_name = "dailycost"

# Schedule expression (default: 9 AM JST daily)
# Use cron format: cron(Minutes Hours Day-of-month Month Day-of-week Year)
# Note: Times are in UTC
schedule_expression = "cron(0 0 * * ? *)"  # UTC 00:00 = JST 09:00


# Notification channels: ["slack"], ["email"], or ["slack", "email"]
notification_channels = ["slack"]

# Required when "slack" is enabled. See docs/SLACK_SETUP.md.
# This is a secret: do not commit terraform.tfvars (or pass it via
# `export TF_VAR_slack_webhook_url=...` instead).
slack_webhook_url = "https://hooks.slack.com/services/<TEAM_ID>/<BOT_ID>/<SECRET>"

# Required when "email" is enabled
# notification_email = "your-email@example.com"
